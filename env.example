# Annie Environment Configuration Template
# ======================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp env.example .env
# 2. Fill in your actual API keys and tokens (replace REPLACE_ME values)
# 3. DO NOT commit .env to version control (it's already in .gitignore)
#
# For production deployments, set ENVIRONMENT=prod and adjust values accordingly.
#

# ============================================================================
# Environment Type
# ============================================================================
# Set to: dev, staging, or prod
# Controls logging verbosity and some runtime behavior
ENVIRONMENT=dev

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Primary LLM provider: "grok-4" or "chatgpt-5"
# At least one API key must be provided based on your chosen provider
LLM_PROVIDER=grok-4

# Grok-4 API Key (required if LLM_PROVIDER=grok-4)
# Get your API key from: https://x.ai/api
GROK_API_KEY=REPLACE_ME

# ChatGPT-5 API Key (required if LLM_PROVIDER=chatgpt-5)
# Get your API key from: https://platform.openai.com/api-keys
CHATGPT_API_KEY=REPLACE_ME

# Grok-4 Live Search Configuration (Optional)
# Live Search provides real-time internet access for Grok-4 responses
# Mode options: "auto" (LLM decides), "on" (always search), "off" (never search)
# Default: auto (recommended - trusts LLM intelligence)
GROK_LIVE_SEARCH_MODE=auto

# Maximum search results to retrieve per query (1-50)
# Higher values = more context but higher cost ($0.025 per source)
# Default: 10
GROK_LIVE_SEARCH_MAX_RESULTS=10

# Cost alert threshold in USD per month
# Alert triggered when projected monthly cost exceeds this value
# Default: 800
GROK_LIVE_SEARCH_COST_ALERT_THRESHOLD=800

# ============================================================================
# Telegram Bot Configuration
# ============================================================================
# Telegram Bot Token (REQUIRED)
# Create a bot and get token from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Authorized Telegram User IDs (REQUIRED)
# Comma-separated list of authorized Telegram user IDs (e.g., "12345,67890,111213")
# Only these users can interact with Annie
# Get your Telegram user ID from: https://t.me/userinfobot
AUTHORIZED_USER_IDS=REPLACE_ME

# Telegram Bot Polling Configuration
# Long polling timeout in seconds (default: 30)
POLLING_TIMEOUT=30

# Maximum retry attempts for failed requests (default: 3)
MAX_RETRIES=3

# ============================================================================
# Tool API Keys
# ============================================================================
# Brave Search API Key (required for internet access tool)
# Get your API key from: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=REPLACE_ME

# Stock API Key (required for stock trader tool)
# Get your API key from your preferred stock data provider
STOCK_API_KEY=REPLACE_ME

# ============================================================================
# External Services
# ============================================================================
# agentic-memories service URL
# Default: http://host.docker.internal:8080 (for local development)
# For production: Set to your deployed agentic-memories service URL
AGENTIC_MEMORIES_URL=http://host.docker.internal:8080

# ============================================================================
# Langfuse Observability (Optional - Story 8.1)
# ============================================================================
# Langfuse provides LLM tracing and observability for monitoring, debugging,
# and analyzing LLM calls, tool executions, and performance metrics.
#
# Get your API keys from: https://cloud.langfuse.com
# Free tier available for development
#
# If keys are not provided, the application will gracefully degrade and
# continue functioning without tracing.

# Langfuse Public Key (optional)
# Get from Langfuse Cloud dashboard: Settings → API Keys
LANGFUSE_PUBLIC_KEY=REPLACE_ME

# Langfuse Secret Key (optional)
# Get from Langfuse Cloud dashboard: Settings → API Keys
LANGFUSE_SECRET_KEY=REPLACE_ME

# Langfuse Host URL (default: https://us.cloud.langfuse.com)
# Use default for Langfuse Cloud US region
# For EU region: https://cloud.langfuse.com
# For self-hosted: Set to your Langfuse instance URL
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Langfuse Project Name (default: Annie)
# Helps organize traces in Langfuse dashboard
LANGFUSE_PROJECT_NAME=Annie

# Langfuse Environment (default: development)
# Helps filter traces by environment in Langfuse dashboard
# Set to: development, staging, or production
LANGFUSE_ENVIRONMENT=development

# ============================================================================
# Redis Configuration
# ============================================================================
# Redis hostname (default: redis - Docker Compose service name)
REDIS_HOST=redis

# Redis port (default: 6379)
REDIS_PORT=6379

# ============================================================================
# Service Configuration
# ============================================================================
# Backend API port (default: 8001 - changed from 8000 to avoid ChromaDB conflict)
# Exposed on host machine at this port
BACKEND_PORT=8001

# Backend URL for internal service communication
# Used by Telegram bot to communicate with backend
# Default: http://backend:8000 (Docker Compose service name)
BACKEND_URL=http://backend:8000

# MCP Server port (default: 8002)
# Exposed on host machine at this port
MCP_SERVER_PORT=8002

# MCP Server URL for internal service communication
# Used by backend to call MCP tools via HTTP
# Default: http://mcp-server:8002 (Docker Compose service name)
MCP_SERVER_URL=http://mcp-server:8002

# ============================================================================
# Timeout Configuration
# ============================================================================
# Timeout values can be adjusted for different environments without code changes
# All timeouts are in seconds

# LLM Client Timeouts (Backend API)
# Total timeout for LLM HTTP requests (default: 180s / 3 minutes)
# Allows time for thinking models and response generation
LLM_REQUEST_TIMEOUT=180

# Max time before failing over to backup LLM provider (default: 180s / 3 minutes)
LLM_FAILOVER_TIMEOUT=180

# Timeout for streaming LLM requests (default: 180s / 3 minutes)
# Allows 2-3 minute LLM response streaming
LLM_STREAMING_TIMEOUT=180

# Backend Client Timeouts (Telegram Bot → Backend API)
# Connection timeout for establishing connection (default: 10s)
BACKEND_CONNECT_TIMEOUT=10

# Socket read timeout for streaming responses (default: 180s / 3 minutes)
# Allows for thinking models + full response streaming
BACKEND_SOCK_READ_TIMEOUT=180

# Telegram Bot Timeouts
# First token timeout for initial LLM response (default: 120s / 2 minutes)
# User receives response within 2 minutes
TELEGRAM_FIRST_TOKEN_TIMEOUT=120

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Verbose logging for development
# INFO: Standard logging (default)
# WARNING+: Production logging (less verbose)
LOG_LEVEL=INFO

# ============================================================================
# Debugging Configuration (Dev Environment Only)
# ============================================================================
# Remote debugging is automatically enabled when ENVIRONMENT=dev
# No additional configuration needed - debugger will listen on these ports:
# 
# Backend debug port (default: 5678)
# BACKEND_DEBUG_PORT=5678
#
# MCP Server debug port (default: 5679)
# MCP_SERVER_DEBUG_PORT=5679
#
# Telegram Bot debug port (default: 5680)
# TELEGRAM_BOT_DEBUG_PORT=5680
#
# Note: Debugging is automatically disabled in production (ENVIRONMENT=prod)
# To use VS Code remote debugging:
# 1. Set ENVIRONMENT=dev in your .env file
# 2. Rebuild containers: docker compose build
# 3. Start services: docker compose up -d
# 4. In VS Code, press F5 and select the appropriate "Remote Attach" configuration
