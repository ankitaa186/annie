# Annie Environment Configuration Template
# ======================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp env.example .env
# 2. Fill in your actual API keys and tokens (replace REPLACE_ME values)
# 3. DO NOT commit .env to version control (it's already in .gitignore)
#
# For production deployments, set ENVIRONMENT=prod and adjust values accordingly.
#

# ============================================================================
# Environment Type
# ============================================================================
# Set to: dev, staging, or prod
# Controls logging verbosity and some runtime behavior
ENVIRONMENT=dev

# ============================================================================
# LLM Model Configuration
# ============================================================================
# Primary LLM model: "gemini-3.1-pro-preview" (default), "grok-4-fast", or "gpt-5.4"
# At least one API key must be provided based on your chosen model
# Legacy values ("grok-4", "chatgpt-5") are also accepted for backward compatibility
LLM_MODEL=gemini-3.1-pro-preview

# Research-specific LLM model (optional)
# Override LLM_MODEL for deep research tasks only
# Useful for using a model with larger output capacity (e.g., gpt-5.4 has 128K output)
# Options: "gemini-3.1-pro-preview", "grok-4-fast", "gpt-5.4"
# Leave empty to use LLM_MODEL for all tasks
RESEARCH_LLM_MODEL=

# xAI API Key (for Grok models)
# Get your API key from: https://x.ai/api
XAI_API_KEY=REPLACE_ME

# OpenAI API Key (for GPT models)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=REPLACE_ME

# Google API Key (for Gemini models)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=REPLACE_ME

# Gemini 3 Pro Configuration (optional - defaults provided)
# Model name (default: gemini-3.1-pro-preview)
GEMINI_MODEL=gemini-3.1-pro-preview

# Max output tokens (default: 8192, max: 65536)
# Higher values allow longer responses but cost more
GEMINI_MAX_OUTPUT_TOKENS=8192

# Temperature (default: 1.0, recommended: keep at 1.0)
# Gemini 3 recommends 1.0 - lowering can cause looping behavior
GEMINI_TEMPERATURE=1.0

# Safety threshold (default: BLOCK_NONE for minimal filtering)
# Options: BLOCK_NONE, BLOCK_ONLY_HIGH, BLOCK_MEDIUM_AND_ABOVE, BLOCK_LOW_AND_ABOVE
# BLOCK_NONE: Minimal safety filtering (recommended for personal use)
GEMINI_SAFETY_SETTING=BLOCK_NONE

# Context cache TTL in seconds (default: 300)
# Context caching reduces costs by 10x for repeated context (requires >2048 tokens)
GEMINI_CONTEXT_CACHE_TTL=300

# Grok-4 Live Search Configuration (Optional)
# Live Search provides real-time internet access for Grok-4 responses
# Mode options: "auto" (LLM decides), "on" (always search), "off" (never search)
# Default: auto (recommended - trusts LLM intelligence)
GROK_LIVE_SEARCH_MODE=auto

# Maximum search results to retrieve per query (1-50)
# Higher values = more context but higher cost ($0.025 per source)
# Default: 10
GROK_LIVE_SEARCH_MAX_RESULTS=10

# Cost alert threshold in USD per month
# Alert triggered when projected monthly cost exceeds this value
# Default: 800
GROK_LIVE_SEARCH_COST_ALERT_THRESHOLD=800

# ============================================================================
# Telegram Bot Configuration
# ============================================================================
# Telegram Bot Token (REQUIRED)
# Create a bot and get token from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Authorized Telegram User IDs (REQUIRED)
# Comma-separated list of authorized Telegram user IDs (e.g., "12345,67890,111213")
# Only these users can interact with Annie
# Get your Telegram user ID from: https://t.me/userinfobot
AUTHORIZED_USER_IDS=REPLACE_ME

# Admin User IDs (Optional)
# Comma-separated list of admin user IDs with elevated privileges
# Admins can use sensitive tools like execute_command (terminal access)
# If not set, no users have admin access
ADMIN_USER_IDS=REPLACE_ME

# Telegram Bot Polling Configuration
# Long polling timeout in seconds (default: 30)
POLLING_TIMEOUT=30

# Maximum retry attempts for failed requests (default: 3)
MAX_RETRIES=3

# ============================================================================
# Tool API Keys
# ============================================================================
# Brave Search API Key (required for internet access tool)
# Get your API key from: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=REPLACE_ME

# Stock API Key (required for stock trader tool)
# Get your API key from your preferred stock data provider
STOCK_API_KEY=REPLACE_ME

# ============================================================================
# Epic 15: Extended MCP Tools
# ============================================================================
# These tools provide web search, web crawl, Reddit search, and profile update

# Web Search (Story 15.1)
# -----------------------
# Tavily API Key - Primary web search provider
# Get your API key from: https://tavily.com
# Cost: ~$0.001 per search, 1000 free requests/month
# If not set, falls back to DuckDuckGo (free, no key required)
TAVILY_API_KEY=

# Web Crawl (Story 15.2)
# ----------------------
# Jina Reader API Key - Fallback web crawler (optional)
# Get your API key from: https://jina.ai/reader
# Free tier available, key optional but increases rate limits
# Primary provider (crawl4ai) is local and requires no key
JINA_API_KEY=

# Reddit Search (Story 15.3)
# --------------------------
# Reddit OAuth credentials for PRAW (official Reddit API)
# Get credentials from: https://www.reddit.com/prefs/apps (create "script" type app)
# Without these, falls back to Reddit JSON API (less reliable, no comments)
# Rate limit: 60 requests/minute with OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# User agent identifies your app to Reddit (required format for OAuth)
REDDIT_USER_AGENT=annie-bot/1.0

# ============================================================================
# Epic 16: Home Assistant Integration
# ============================================================================
# Bidirectional integration with Home Assistant for smart home control
# Query entity states, control devices, and receive MQTT alerts via Telegram

# Home Assistant REST API Configuration
# -------------------------------------
# Base URL of your Home Assistant instance (required for HA integration)
# Format: http://IP_ADDRESS:8123 or http://HOSTNAME:8123
# Example: http://192.168.1.100:8123 or http://homeassistant.local:8123
HA_URL=http://homeassistant.local:8123

# Long-Lived Access Token (required for HA integration)
# Generate in Home Assistant: Profile → Security → Long-Lived Access Tokens
# Documentation: https://www.home-assistant.io/docs/authentication/#your-account-profile
# SENSITIVE: This token provides full API access - keep it secure
HA_ACCESS_TOKEN=

# Control Allowlist (optional, security feature)
# Comma-separated list of entity IDs that can be controlled via home_assistant_control tool
# Supports wildcards: "light.*" allows all lights, "switch.office_*" allows office switches
# Examples:
#   - Single entity: light.living_room
#   - Multiple entities: light.living_room,switch.fan,climate.thermostat
#   - Wildcard domain: light.*,switch.*
#   - Mixed: light.*,switch.office_fan,climate.thermostat
# SECURITY: Empty allowlist = no control operations permitted (query-only mode)
HA_CONTROL_ALLOWLIST=

# HTTP request timeout in seconds (default: 10)
# Increase if HA instance is slow or on remote network
HA_TIMEOUT=10

# MQTT Configuration (Optional - for Home Assistant → Annie alerts)
# -----------------------------------------------------------------
# Enable MQTT to receive proactive alerts from Home Assistant automations
# Alerts are forwarded to Telegram using the configured alert user ID

# Mosquitto broker hostname (leave empty to disable MQTT)
# Examples: localhost, 192.168.1.100, mqtt.local
HA_MQTT_BROKER=homeassistant.local

# Mosquitto broker port (default: 1883)
HA_MQTT_PORT=1883

# MQTT authentication (optional - only if broker requires auth)
HA_MQTT_USERNAME=
# SENSITIVE: Password is masked in logs
HA_MQTT_PASSWORD=

# MQTT topics to subscribe to (default: annie/alerts/#)
# Supports MQTT wildcards: # (multi-level), + (single-level)
# Examples:
#   - annie/alerts/# subscribes to all annie/alerts/* topics
#   - homeassistant/sensor/+ subscribes to all sensor topics
HA_MQTT_TOPICS=annie/alerts/#

# Telegram user ID to receive MQTT alerts (required if MQTT enabled)
# Get your Telegram user ID from: https://t.me/userinfobot
# Only this user receives Home Assistant alert notifications
HA_MQTT_ALERT_USER_ID=

# ============================================================================
# External Services
# ============================================================================
# agentic-memories service URL
# Default: http://host.docker.internal:8080 (for local development)
# For production: Set to your deployed agentic-memories service URL
AGENTIC_MEMORIES_URL=http://host.docker.internal:8080

# Host Terminal MCP Configuration (optional - for host command execution)
# Allows Annie to execute terminal commands on the host machine
# Requires: uv tool install 'host-terminal-mcp[http]'
# Server is automatically started/updated by 'make start'

# URL for Docker containers to reach host-terminal-mcp
# Default: http://host.docker.internal:8099
HOST_TERMINAL_URL=http://host.docker.internal:8099

# Port for host-terminal-mcp server (default: 8099)
HOST_TERMINAL_PORT=8099

# Permission mode for terminal commands
# Options: "allowlist" (config-based), "ask" (interactive approval), "yolo" (allow all - DANGEROUS)
# Default: allowlist (uses host-terminal-mcp's built-in allowlist)
HOST_TERMINAL_MODE=allowlist

# ============================================================================
# Langfuse Observability (Optional - Story 8.1)
# ============================================================================
# Langfuse provides LLM tracing and observability for monitoring, debugging,
# and analyzing LLM calls, tool executions, and performance metrics.
#
# Get your API keys from: https://cloud.langfuse.com
# Free tier available for development
#
# If keys are not provided, the application will gracefully degrade and
# continue functioning without tracing.

# Langfuse Public Key (optional)
# Get from Langfuse Cloud dashboard: Settings → API Keys
LANGFUSE_PUBLIC_KEY=REPLACE_ME

# Langfuse Secret Key (optional)
# Get from Langfuse Cloud dashboard: Settings → API Keys
LANGFUSE_SECRET_KEY=REPLACE_ME

# Langfuse Host URL (default: https://us.cloud.langfuse.com)
# Use default for Langfuse Cloud US region
# For EU region: https://cloud.langfuse.com
# For self-hosted: Set to your Langfuse instance URL
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Langfuse Project Name (default: Annie)
# Helps organize traces in Langfuse dashboard
LANGFUSE_PROJECT_NAME=Annie

# Langfuse Environment (default: development)
# Helps filter traces by environment in Langfuse dashboard
# Set to: development, staging, or production
LANGFUSE_ENVIRONMENT=development

# ============================================================================
# Cloud Logging - Grafana Loki (Epic 17)
# ============================================================================
# Cloud logging with Grafana Loki for production deployments only.
# Enables remote log access, LogQL queries, and alerting via Grafana Cloud.
#
# PREREQUISITES:
# 1. Install Loki Docker plugin (one-time on production host):
#    docker plugin install grafana/loki-docker-driver:latest --alias loki --grant-all-permissions
#
# 2. Create free Grafana Cloud account: https://grafana.com/products/cloud/
#
# 3. Get your Loki push URL:
#    Grafana Cloud → Connections → Hosted Logs → Loki → Details
#
# USAGE:
# - Development (default): make start          (uses local docker logs)
# - Production:            make start ENV=prod (sends logs to Grafana Cloud)

# Loki Push URL (required for ENV=prod only)
# Format: https://<user-id>:<api-key>@<host>/loki/api/v1/push
# Example: https://123456:glc_abc123...@logs-prod-us-central1.grafana.net/loki/api/v1/push
LOKI_URL=

# ============================================================================
# Redis Configuration
# ============================================================================
# Redis hostname (default: redis - Docker Compose service name)
REDIS_HOST=redis

# Redis port (default: 6379)
REDIS_PORT=6379

# ============================================================================
# Service Configuration
# ============================================================================
# Backend API port (default: 8001 - changed from 8000 to avoid ChromaDB conflict)
# Exposed on host machine at this port
BACKEND_PORT=8001

# Backend URL for internal service communication
# Used by Telegram bot to communicate with backend
# Default: http://backend:8000 (Docker Compose service name)
BACKEND_URL=http://backend:8000

# MCP Server port (default: 8002)
# Exposed on host machine at this port
MCP_SERVER_PORT=8002

# MCP Server URL for internal service communication
# Used by backend to call MCP tools via HTTP
# Default: http://mcp-server:8002 (Docker Compose service name)
MCP_SERVER_URL=http://mcp-server:8002

# ============================================================================
# Timeout Configuration
# ============================================================================
# Timeout values can be adjusted for different environments without code changes
# All timeouts are in seconds

# LLM Client Timeouts (Backend API)
# Total timeout for LLM HTTP requests (default: 180s / 3 minutes)
# Allows time for thinking models and response generation
LLM_REQUEST_TIMEOUT=180

# Max time before failing over to backup LLM provider (default: 180s / 3 minutes)
LLM_FAILOVER_TIMEOUT=180

# Timeout for streaming LLM requests (default: 180s / 3 minutes)
# Allows 2-3 minute LLM response streaming
LLM_STREAMING_TIMEOUT=180

# Backend Client Timeouts (Telegram Bot → Backend API)
# Connection timeout for establishing connection (default: 10s)
BACKEND_CONNECT_TIMEOUT=10

# Socket read timeout for streaming responses (default: 180s / 3 minutes)
# Allows for thinking models + full response streaming
BACKEND_SOCK_READ_TIMEOUT=180

# Telegram Bot Timeouts
# First token timeout for initial LLM response (default: 120s / 2 minutes)
# User receives response within 2 minutes
TELEGRAM_FIRST_TOKEN_TIMEOUT=120

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Verbose logging for development
# INFO: Standard logging (default)
# WARNING+: Production logging (less verbose)
LOG_LEVEL=INFO

# ============================================================================
# Debugging Configuration (Dev Environment Only)
# ============================================================================
# Remote debugging is automatically enabled when ENVIRONMENT=dev
# No additional configuration needed - debugger will listen on these ports:
# 
# Backend debug port (default: 5678)
# BACKEND_DEBUG_PORT=5678
#
# MCP Server debug port (default: 5679)
# MCP_SERVER_DEBUG_PORT=5679
#
# Telegram Bot debug port (default: 5680)
# TELEGRAM_BOT_DEBUG_PORT=5680
#
# Note: Debugging is automatically disabled in production (ENVIRONMENT=prod)
# To use VS Code remote debugging:
# 1. Set ENVIRONMENT=dev in your .env file
# 2. Rebuild containers: docker compose build
# 3. Start services: docker compose up -d
# 4. In VS Code, press F5 and select the appropriate "Remote Attach" configuration
