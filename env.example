# Annie Environment Configuration Template
# ======================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env: cp env.example .env
# 2. Fill in your actual API keys and tokens (replace REPLACE_ME values)
# 3. DO NOT commit .env to version control (it's already in .gitignore)
#
# For production deployments, set ENVIRONMENT=prod and adjust values accordingly.
#

# ============================================================================
# Environment Type
# ============================================================================
# Set to: dev, staging, or prod
# Controls logging verbosity and some runtime behavior
ENVIRONMENT=dev

# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Primary LLM provider: "grok-4" or "chatgpt-5"
# At least one API key must be provided based on your chosen provider
LLM_PROVIDER=grok-4

# Grok-4 API Key (required if LLM_PROVIDER=grok-4)
# Get your API key from: https://x.ai/api
GROK_API_KEY=REPLACE_ME

# ChatGPT-5 API Key (required if LLM_PROVIDER=chatgpt-5)
# Get your API key from: https://platform.openai.com/api-keys
CHATGPT_API_KEY=REPLACE_ME

# ============================================================================
# Telegram Bot Configuration
# ============================================================================
# Telegram Bot Token (REQUIRED)
# Create a bot and get token from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=REPLACE_ME

# ============================================================================
# Tool API Keys
# ============================================================================
# Brave Search API Key (required for internet access tool)
# Get your API key from: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=REPLACE_ME

# Stock API Key (required for stock trader tool)
# Get your API key from your preferred stock data provider
STOCK_API_KEY=REPLACE_ME

# ============================================================================
# External Services
# ============================================================================
# agentic-memories service URL
# Default: http://host.docker.internal:8080 (for local development)
# For production: Set to your deployed agentic-memories service URL
AGENTIC_MEMORIES_URL=http://host.docker.internal:8080

# ============================================================================
# Redis Configuration
# ============================================================================
# Redis hostname (default: redis - Docker Compose service name)
REDIS_HOST=redis

# Redis port (default: 6379)
REDIS_PORT=6379

# ============================================================================
# Service Configuration
# ============================================================================
# Backend API port (default: 8001 - changed from 8000 to avoid ChromaDB conflict)
# Exposed on host machine at this port
BACKEND_PORT=8001

# Backend URL for internal service communication
# Used by Telegram bot to communicate with backend
# Default: http://backend:8000 (Docker Compose service name)
BACKEND_URL=http://backend:8000

# MCP Server container name
# Used by backend to identify MCP server container
# Default: mcp-server (Docker Compose service name)
MCP_SERVER_NAME=mcp-server

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG: Verbose logging for development
# INFO: Standard logging (default)
# WARNING+: Production logging (less verbose)
LOG_LEVEL=INFO
